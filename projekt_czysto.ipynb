        "\n",
        "  X_train, X_test, y_train, y_test, df_train, df_test = train_test_split(\n",
        "      X, y, df_gb, test_size=0.2, random_state=42, stratify=y\n",
        "  )\n",
        "\n",
        "  # 1) policz progi per bucket\n",
        "  results_df, total_loss = find_optimal_buckets_thresholds(y_proba_gb, df_test)\n",
        "\n",
        "  print(results_df)\n",
        "  print(f\"\\nTotal expected loss (all buckets): ${total_loss:,.0f}\")\n",
        "\n",
        "  # 2) zrób mapę bucket -> threshold\n",
        "  thr_map = dict(zip(results_df[\"bucket\"], results_df[\"best_threshold\"]))\n",
        "\n",
        "  # 3) zastosuj progi per bucket do predykcji\n",
        "  df_eval = df_test.copy()\n",
        "  df_eval[\"p_churn_gb\"] = y_proba_gb\n",
        "\n",
        "  df_eval[\"thr_bucket\"] = (\n",
        "      df_eval[\"tenure_bucket\"]\n",
        "      .map(thr_map)\n",
        "      .astype(float)\n",
        "      .fillna(0.5)   # fallback\n",
        "  )\n",
        "\n",
        "  df_eval[\"y_pred_gb_bucket\"] = (\n",
        "      df_eval[\"p_churn_gb\"] >= df_eval[\"thr_bucket\"]\n",
        "  ).astype(int)\n",
        "\n",
        "\n",
        "  # raport\n",
        "  print_classification_report_with_buckets(\n",
        "      df=df_eval,\n",
        "      y_true_col=\"Churn\",\n",
        "      y_pred_col=\"y_pred_gb_bucket\",\n",
        "      bucket_col=\"tenure_bucket\",\n",
        "      title=\"GB — best thresholds per buckets\"\n",
        "  )\n"
      ],

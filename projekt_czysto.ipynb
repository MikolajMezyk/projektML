        "def evaluate_model_per_bucket(\n",
        "    model_name: str,\n",
        "    y_proba: np.ndarray,\n",
        "    df_test: pd.DataFrame\n",
        "):\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(model_name)\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    # best thresholds per bucket\n",
        "    results_df, total_loss = find_optimal_buckets_thresholds(y_proba, df_test)\n",
        "\n",
        "    print(\"\\nBest thresholds per bucket:\")\n",
        "    print(results_df)\n",
        "\n",
        "    print(f\"\\nTotal expected loss: ${total_loss:,.0f}\")\n",
        "\n",
        "    # mapa threshold na bucket\n",
        "    thr_map = dict(zip(results_df[\"bucket\"], results_df[\"best_threshold\"]))\n",
        "\n",
        "    df_eval = df_test.copy()\n",
        "    df_eval[\"p_churn\"] = y_proba\n",
        "\n",
        "    df_eval[\"thr_bucket\"] = (\n",
        "        df_eval[\"tenure_bucket\"]\n",
        "        .map(thr_map)\n",
        "        .astype(float)\n",
        "        .fillna(0.5)\n",
        "    )\n",
        "\n",
        "    df_eval[\"y_pred_bucket\"] = (\n",
        "        df_eval[\"p_churn\"] >= df_eval[\"thr_bucket\"]\n",
        "    ).astype(int)\n",
        "\n",
        "    # 4) raport\n",
        "    print_classification_report_with_buckets(\n",
        "        df=df_eval,\n",
        "        y_true_col=\"Churn\",\n",
        "        y_pred_col=\"y_pred_bucket\",\n",
        "        bucket_col=\"tenure_bucket\",\n",
        "        title=f\"{model_name} — best thresholds per buckets\"\n",
        "    )\n",
        "\n",
        "    return results_df, total_loss"
      ],

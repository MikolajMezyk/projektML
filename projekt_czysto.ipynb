        "def tendure_bucket(tenure):\n",
        "    if tenure <= 3:\n",
        "        return \"0-3\"\n",
        "    elif tenure <= 6:\n",
        "        return \"4-6\"\n",
        "    elif tenure <= 12:\n",
        "        return \"7-12\"\n",
        "    elif tenure <= 24:\n",
        "        return \"13-24\"\n",
        "    else:\n",
        "        return \"25+\"\n",
        "\n",
        "\n",
        "remaining_months = {\n",
        "    \"0-3\": 24,\n",
        "    \"4-6\": 14,\n",
        "    \"7-12\": 12,\n",
        "    \"13-24\": 10,\n",
        "    \"25+\": 6\n",
        "}\n"
      ]
